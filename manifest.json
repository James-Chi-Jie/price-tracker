{
  "manifest_version": 3,
  "name": "多平台低价预警",
  "version": "0.12.5",
  "description": "在本地浏览器中定时搜索多个电商平台商品，并在价格低于阈值时提醒。",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.jd.com/*",
    "https://*.tmall.com/*",
    "https://*.taobao.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "多平台低价预警",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jd.com/*",
        "https://*.tmall.com/*",
        "https://*.taobao.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
